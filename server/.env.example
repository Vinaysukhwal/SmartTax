# MongoDB connection string (use MongoDB Atlas free tier)
# Get yours at: https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smarttax

# Secret key for signing JWT tokens (use any random string)
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini API key (free tier)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server port
PORT=5000
